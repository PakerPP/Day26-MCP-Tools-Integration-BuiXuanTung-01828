# Copy file nay thanh .env roi dien key that
# OpenAI (khuyen nghi cho lab nay)
OPENAI_API_KEY=sk-...

# Tuy chon: doi model OpenAI (mac dinh openai/gpt-4o-mini)
# OPENAI_MODEL=openai/gpt-4o-mini

# Tuy chon: dung Gemini thay cho OpenAI
# GOOGLE_API_KEY=...

# Tuy chon: doi dia chi MCP server (mac dinh http://localhost:8085/mcp)
# MCP_SERVER_URL=http://localhost:8085/mcp
